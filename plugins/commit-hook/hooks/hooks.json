{
  "description": "Run the commands in COMMIT_HOOK_COMMANDS before git commit",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git commit*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/commit-hook.ts\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
